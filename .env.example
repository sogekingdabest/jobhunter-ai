# Application
JOBHUNTER_ENVIRONMENT=development
JOBHUNTER_LOG_LEVEL=INFO
JOBHUNTER_DATABASE_URL=postgresql+psycopg://jobhunter:jobhunter@127.0.0.1:5432/jobhunter
JOBHUNTER_DOCUMENT_STORAGE_PATH=storage/documents
JOBHUNTER_DOCUMENT_MAX_SIZE_BYTES=10485760
JOBHUNTER_JOB_URL_MAX_RESPONSE_BYTES=2097152
JOBHUNTER_JOB_URL_MAX_EXTRACTED_CHARACTERS=100000
JOBHUNTER_JOB_URL_MAX_REDIRECTS=5
JOBHUNTER_JOB_URL_CONNECT_TIMEOUT_SECONDS=5
JOBHUNTER_JOB_URL_READ_TIMEOUT_SECONDS=10
JOBHUNTER_JOB_URL_TOTAL_TIMEOUT_SECONDS=20

# Local PostgreSQL container
POSTGRES_DB=jobhunter
POSTGRES_USER=jobhunter
POSTGRES_PASSWORD=jobhunter
POSTGRES_PORT=5432
